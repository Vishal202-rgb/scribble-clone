# ==========================================
# Backend (Server) Environment Variables
# ==========================================

# Port (Render automatically sets $PORT in production; default: 5000)
PORT=5000

# Server Host (default: 0.0.0.0)
HOST=0.0.0.0

# Node Environment: 'development' | 'production'
NODE_ENV=development

# Allowed Client Origins for CORS (comma-separated, wildcards supported)
# Local Development:
CLIENT_ORIGIN=http://localhost:3000

# Production (Render Dashboard):
# Set CLIENT_ORIGIN to your deployed Vercel domain(s):
# CLIENT_ORIGIN=https://your-app-name.vercel.app,https://your-app-name-*.vercel.app
